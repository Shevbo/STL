# systemd --user на smain: ~/.config/systemd/user/stl-workbench.service
# Секреты: ~/.config/stl-workbench/worker.env (600): STL_API_BASE, WORKBENCH_WORKER_TOKEN.
# Запуск: systemctl --user daemon-reload && systemctl --user enable --now stl-workbench
[Unit]
Description=stl-workbench: воркер рабочего места бэктеста (claude -p в worktree wb/<card>/<rev>)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/stl-workbench
EnvironmentFile=%h/.config/stl-workbench/worker.env
# claude нужен HTTPS_PROXY (Lineman); локальные адреса и WG мимо прокси.
Environment=HTTPS_PROXY=http://127.0.0.1:9090
Environment=HTTP_PROXY=http://127.0.0.1:9090
Environment=NO_PROXY=127.0.0.1,localhost,10.66.0.1
Environment=WB_REPO=%h/stl-workbench
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/stl-workbench/.venv/bin/python scripts/workbench_worker.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
